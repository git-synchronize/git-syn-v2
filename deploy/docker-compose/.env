# Copy this file to .env and adjust values before running docker compose up.

# GIT_HTTP_EXPORT_ALL
# Set to 1 to allow cloning/pushing to any repository under GIT_PROJECT_ROOT
# without requiring a git-daemon-export-ok marker file.
# Default: 1
GIT_HTTP_EXPORT_ALL=1

# GIT_PROJECT_ROOT
# Absolute path inside the container where git repositories are stored.
# Repositories are served at http://<host>/<repo-name>.git
# Default: /git
GIT_PROJECT_ROOT=/git
